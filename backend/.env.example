MONGO_URL=mongodb://localhost:27017
DB_NAME=skyn

# Optional: enables GPT-4o powered recommendations. If empty, deterministic
# fallback recommendations are used.
EMERGENT_LLM_KEY=

# iOS bundle identifier — required to validate the `aud` claim of Apple
# Sign-In identity tokens (see app.json -> expo.ios.bundleIdentifier).
APPLE_BUNDLE_ID=com.skyn.app

# Comma-separated list of allowed origins for CORS, e.g.
# https://app.skyn.com,http://localhost:8081
CORS_ORIGINS=
